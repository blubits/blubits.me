---
/**
 * PageTitle — canonical page-level heading component.
 *
 * Sizes:
 *   xl  – 6xl/7xl/8xl bold (homepage hero)
 *   lg  – 5xl/6xl bold     (hero pages)
 *   md  – 4xl bold        (error pages)
 *   sm  – lg/xl semibold  (notes sub-pages with back-arrow)
 *
 * Instrument Sans is reserved for display headings while Geist handles
 * body and interface text across the site.
 */

interface Props {
  size?: "xl" | "lg" | "md" | "sm";
  class?: string;
}

const { size = "lg", class: className } = Astro.props;
---

<h1
  class:list={[
    "font-display tracking-tight",
    size === "xl" && "text-6xl md:text-7xl lg:text-8xl leading-none font-bold",
    size === "lg" && "text-5xl md:text-6xl leading-none font-bold",
    size === "md" && "text-4xl leading-none font-bold",
    size === "sm" && "text-lg md:text-xl font-semibold",
    className,
  ]}
>
  <slot />
</h1>
