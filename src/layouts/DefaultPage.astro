---
import Footer from "@/components/nav/Footer.astro";
import Logo from "@/components/nav/Logo.astro";
import Navbar from "@/components/nav/Navbar.jsx";
import Container from "@/layouts/containers/Container.astro";
import { themes, type ThemeConfig } from "@/types/theme";
import { LOGO_STYLES } from "@/constants/ui";

interface Props {
  theme?: ThemeConfig['name'];
  customTheme?: Partial<ThemeConfig>;
  backgroundLogo?: boolean;
}

const {
  theme = 'default',
  customTheme,
  backgroundLogo = false,
} = Astro.props;

const themeConfig = customTheme 
  ? { ...themes[theme], ...customTheme }
  : themes[theme];
---

<body
  class:list={[
    "relative m-auto min-h-screen pt-8 pb-12 md:pt-16",
    themeConfig.background,
    themeConfig.foreground,
    `theme-${themeConfig.name}`,
  ]}
>
  {backgroundLogo && (
    <Logo
      class="pointer-events-none fixed right-[-6rem] bottom-[-8rem] z-0 size-[min(26rem,85vw)] stroke-stone-300 opacity-60 md:right-[-8rem] md:bottom-[-10rem] md:size-[min(42rem,58vw)]"
      decorative
    />
  )}

  <div class="relative z-10">
    <Container>
      <Navbar client:load>
        <Logo
          class:list={[
            LOGO_STYLES.base,
            themeConfig.logoBackground,
            themeConfig.logoForeground,
            LOGO_STYLES.hover,
          ]}
        />
      </Navbar>
    </Container>

    <main class="overflow-visible">
      <slot />
    </main>

    <Container>
      <Footer />
    </Container>
  </div>
</body>
