---
import PageTitle from "@/components/layout/PageTitle.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/layouts/containers/Container.astro";
import DefaultPage from "@/layouts/DefaultPage.astro";
import Layout from "@/layouts/Layout.astro";

// SEO meta tags
const pageTitle = "Maded Batara III";
const pageDescription = "Maded Batara III (Maded) – personal website and portfolio by Maded Batara III. Developer and storyteller.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Maded Batara III",
  "alternateName": "Maded",
  "url": "https://blubits.me/",
  "sameAs": [
    "https://blubits.me/"
  ],
  "description": pageDescription
};
---

<Layout 
  title={pageTitle}
>
  <head slot="head">
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blubits.me/" />
    <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  </head>
  <DefaultPage
    backgroundLogo
    customTheme={{
      background: "bg-stone-50",
      logoBackground: "bg-transparent",
    }}
  >
    <Container>
      <PageTitle size="lg" class="mb-8 max-w-2xl">
        Maded is a software developer based in Pasig City, Philippines.
      </PageTitle>
      
      <Button href="mailto:dev@contact.blubits.me" variant="secondary" class="mt-6">Contact me</Button>

    </Container>
  </DefaultPage>
</Layout>
