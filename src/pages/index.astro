---
import PageTitle from "@/components/layout/PageTitle.astro";
import Container from "@/layouts/containers/Container.astro";
import DefaultPage from "@/layouts/DefaultPage.astro";
import Layout from "@/layouts/Layout.astro";

// SEO meta tags
const pageTitle = "Maded Batara III";
const pageDescription = "Maded Batara III (Maded) – personal website and portfolio by Maded Batara III. Developer and storyteller.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Maded Batara III",
  "alternateName": "Maded",
  "url": "https://blubits.me/",
  "sameAs": [
    "https://blubits.me/"
  ],
  "description": pageDescription
};
---

<Layout 
  title={pageTitle}
>
  <head slot="head">
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blubits.me/" />
    <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  </head>
  <DefaultPage
    backgroundLogo
    customTheme={{
      background: "bg-stone-50",
      logoBackground: "bg-transparent",
    }}
  >
    <Container>
      <PageTitle size="lead" class="mb-8 max-w-4xl">
        Telling stories and solving problems through code.
      </PageTitle>
      <div class="flex flex-col gap-6">
          <p class="max-w-xl text-lg leading-normal">
            Hi there! I'm Maded. Someday I hope to do something that changes the system to be for the
            good of the many, not the few. But right now, I'm a freelance
            developer, with years of experience helping others succeed.
          </p>
          <p class="max-w-xl text-lg leading-normal">
            I graduated with a degree in computer science from the University of
            the Philippines. When I'm not coding, I like writing, learning about
            new stuff, video games, and exploring.
          </p>
      </div>

    </Container>
  </DefaultPage>
</Layout>
